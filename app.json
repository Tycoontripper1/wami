{
  "expo": {
    "name": "wami",
    "slug": "wami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wami",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/wami-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00BCD4",
      "dark": {
        "image": "./assets/images/wami-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F1419"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.b_laj.wami",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResources": true,
      "enableDangerousExperimentalLeanBuilds": true,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.b_laj.wami",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wami uses your location to show creatives and listings near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wami needs your photos so you can add pictures to your listings and profile.",
          "cameraPermission": "Wami needs the camera so you can take photos of what you make."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fdf1304-bd60-4ec9-83d6-284cb61bd10f"
      }
    },
    "owner": "b_laj"
  }
}
